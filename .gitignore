# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
/out-tsc

# 后端构建产物：由 `npm run build:edge` 生成，EdgeOne 部署时会在构建阶段重新产出。
# 若你使用「从本地目录部署」并希望把产物一并提交，可用 git add -f cloud-functions 强制加入。
/cloud-functions

# 本地开发数据：node:sqlite 数据库文件 + 磁盘文件存储，仅用于本地调试
/.data

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

.claude/worktrees
.claude/settings.local.json

# playwright-cli local debugging artifacts
/.playwright-cli
wrangler.test.jsonc

# VitePress 文档站产物与缓存
/docs/.vitepress/dist
/docs/.vitepress/cache

# 参考项目源码（仅本地对照，不进入版本库）
/references

{
  "name": "@drawnix/source",
  "version": "0.0.2",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "nx serve web --host=0.0.0.0",
    "build": "nx run-many -t=build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:web": "nx build web",
    "test": "nx run-many -t=test",
    "release": "node scripts/release-version.js",
    "pub": "npm run build && node scripts/publish.js",
    "dev:api": "node scripts/dev-api.mjs",
    "test:api": "node scripts/smoke-api.mjs",
    "typecheck:api": "tsc -p apps/api/tsconfig.json",
    "build:api:edge": "node scripts/build-edge.mjs",
    "build:edge": "nx build web && node scripts/build-edge.mjs",
    "dev:cf": "nx build web && npx wrangler dev",
    "deploy:cf": "nx build web && npx wrangler deploy",
    "d1:init": "npx wrangler d1 execute drawnix --remote --file=./migrations/0001_init.sql"
  },

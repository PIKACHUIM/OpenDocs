# 基本缓存配置

# 带内容 hash 的构建产物可以长期强缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# SPA 入口必须每次校验，否则发新版后用户会长时间看到旧页面
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# 其余路径（含 /s/<token> 这类深链）同样不可长期缓存
#
# 安全头说明：
# - CSP 里 script-src 不含 'unsafe-inline'：构建产物只有外链 module script，
#   这样即便某处出现注入点，内联 <script> 也不会执行
# - 允许 Turnstile 的脚本/接口域名，否则登录页的人机验证会加载失败
# - frame-src 只放行视频站点：PPT 的「网页」元素已在组件里限制为外部 http(s)
# - frame-ancestors/X-Frame-Options 同时给出，防点击劫持
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://player.bilibili.com https://player.vimeo.com; worker-src 'self' blob:; manifest-src 'self'

# 注意：_headers 只对「静态资产响应」生效，命中 Worker 代码（/api/* 等）的请求不会经过它，
# API 的响应头需要在代码内部设置（apps/api/src/lib/http.ts 与 routes/assets.ts 已处理）

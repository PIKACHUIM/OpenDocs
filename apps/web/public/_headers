# 基本缓存配置

# 带内容 hash 的构建产物可以长期强缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# SPA 入口必须每次校验，否则发新版后用户会长时间看到旧页面
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# 其余路径（含 /s/<token> 这类深链）同样不可长期缓存
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# 注意：_headers 只对「静态资产响应」生效，命中 Worker 代码（/api/* 等）的请求不会经过它，
# API 的响应头需要在代码内部设置（apps/api/src/lib/http.ts 的 json() 已带 Cache-Control: no-store）
